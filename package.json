{
  "name": "interview-memo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "docker compose up -d db && pnpm db:migrate:local && pnpm dev",
    "infra:init": "terraform -chdir=infra init",
    "infra:plan": "node infra/scripts/terraform-with-wrangler-auth.mjs plan",
    "infra:apply": "node infra/scripts/terraform-with-wrangler-auth.mjs apply && pnpm infra:sync",
    "infra:sync": "node infra/scripts/sync-wrangler.mjs",
    "infra:validate": "terraform -chdir=infra validate",
    "infra:test": "terraform -chdir=infra test",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate:local": "pnpm --filter @repo/db db:migrate:local",
    "db:migrate:remote": "pnpm --filter @repo/db db:migrate:remote",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "typescript": "^6.0.3"
  }
}
