# Local development uses the libSQL server from docker compose.
DATABASE_URL=http://127.0.0.1:18080
DATABASE_AUTH_TOKEN=

# GitHubのリポジトリURLを設定すると、画面のIssue / PR導線が有効になります。
NEXT_PUBLIC_GITHUB_REPO_URL=

# Local development uses the no-network local driver by default.
# To spend Cloudflare AI credits intentionally, set CLOUDFLARE_AI_DRIVER=cloudflare
# in apps/web/.env.local and run pnpm --filter @repo/web exec wrangler login.
CLOUDFLARE_AI_DRIVER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
