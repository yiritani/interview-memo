# Local development uses the libSQL server from docker compose.
DATABASE_URL=http://127.0.0.1:18080
DATABASE_AUTH_TOKEN=

# GitHubのリポジトリURLを設定すると、画面のIssue / PR導線が有効になります。
NEXT_PUBLIC_GITHUB_REPO_URL=

# Optional: enables real Workers AI calls from the local Hono API.
# For Wrangler OAuth, set CLOUDFLARE_AI_LOCAL=true in apps/web/.env.local
# and run pnpm --filter @repo/web exec wrangler login.
# Leave these empty to use the no-network local fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
