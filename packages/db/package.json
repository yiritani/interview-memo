    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0",
    "typescript": "^6.0.3"
  }
